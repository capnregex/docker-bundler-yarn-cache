#!/usr/bin/env bash
# Setup this monorepo after a fresh clone (or re-run anytime — idempotent).
#
# Installs mise if missing, installs mise tools from mise.toml, downloads gems
# + node packages into shared host caches, installs them for local use, and
# prepares Fred + George databases. Run this on the host before docker compose
# so containers can prefer those cached downloads (see bin/docker-app).
#
# Usage:
#   bin/setup
#   bin/setup --reset          # also reset app databases
#   bin/setup --docker-build   # build the Arch dev image after host setup
#   bin/setup --skip-mise      # do not install mise or run mise install
#   bin/setup --skip-js        # skip yarn install / yarn cache warm
#   bin/setup --skip-db        # skip rails db:prepare
#   bin/setup --skip-apps      # only root gems + yarn (no per-app bundle/db)
#   bin/setup --skip-cache     # install only; do not run bundle cache / package

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

SKIP_MISE=0
SKIP_JS=0
SKIP_DB=0
SKIP_APPS=0
SKIP_CACHE=0
DOCKER_BUILD=0
RESET_DB=0

for arg in "$@"; do
  case "$arg" in
    --skip-mise) SKIP_MISE=1 ;;
    --skip-js) SKIP_JS=1 ;;
    --skip-db) SKIP_DB=1 ;;
    --skip-apps) SKIP_APPS=1 ;;
    --skip-cache) SKIP_CACHE=1 ;;
    --docker-build) DOCKER_BUILD=1 ;;
    --reset) RESET_DB=1 ;;
    -h|--help)
      awk 'NR==1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
      exit 0
      ;;
    *)
      echo "Unknown option: $arg" >&2
      echo "Run bin/setup --help for usage." >&2
      exit 1
      ;;
  esac
done

step() {
  printf '\n== %s ==\n' "$1"
}

run() {
  echo "+ $*"
  "$@"
}

require_cmd() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "error: required command not found: $1" >&2
    exit 1
  fi
}

# Prefer mise-provided tools on PATH. Skip full activate if this shell (or a
# parent that exported MISE_SHELL) already ran `mise activate`.
activate_mise() {
  if ! command -v mise >/dev/null 2>&1; then
    return 0
  fi
  if [[ -n "${MISE_SHELL:-}" ]]; then
    echo "mise already activated (MISE_SHELL=${MISE_SHELL}); refreshing tool env"
    # shellcheck disable=SC1091
    eval "$(mise hook-env -s bash)" 2>/dev/null || true
    return 0
  fi
  # shellcheck disable=SC1091
  eval "$(mise activate bash)"
}

# Ensure ~/.local/bin is on PATH (default location for curl https://mise.run | sh).
ensure_local_bin_on_path() {
  local local_bin="${HOME}/.local/bin"
  if [[ -d "$local_bin" && ":${PATH}:" != *":${local_bin}:"* ]]; then
    export PATH="${local_bin}:${PATH}"
  fi
}

# Install mise if missing (macOS / Linux / WSL). Official installer: https://mise.jdx.dev
install_mise() {
  step "Installing mise (not found on PATH)"
  ensure_local_bin_on_path

  if command -v mise >/dev/null 2>&1; then
    echo "mise already available after PATH refresh: $(command -v mise)"
    return 0
  fi

  if ! command -v curl >/dev/null 2>&1; then
    echo "error: mise is not installed and curl is missing (needed for https://mise.run)" >&2
    echo "       install mise manually: https://mise.jdx.dev/installing-mise.html" >&2
    exit 1
  fi

  echo "Installing mise via https://mise.run (installs to ~/.local/bin by default)"
  run curl https://mise.run | sh
  ensure_local_bin_on_path

  if ! command -v mise >/dev/null 2>&1; then
    # Installer may have written the binary even if PATH still lacks it.
    if [[ -x "${HOME}/.local/bin/mise" ]]; then
      export PATH="${HOME}/.local/bin:${PATH}"
    fi
  fi

  if ! command -v mise >/dev/null 2>&1; then
    echo "error: mise install finished but 'mise' is still not on PATH" >&2
    echo "       expected binary at ~/.local/bin/mise — add that dir to PATH and re-run" >&2
    echo "       docs: https://mise.jdx.dev/installing-mise.html" >&2
    exit 1
  fi

  echo "mise installed: $(command -v mise) ($(mise --version 2>/dev/null || true))"
}

cache_gems() {
  # Package .gem files into .cache/rubygems for Docker/host offline preference.
  # --all-platforms covers linux container installs from a host lockfile.
  run bundle cache --all-platforms
}

step "Repository root"
echo "$ROOT"

# --- mise (Ruby / Node / Yarn) -------------------------------------------------
if [[ "$SKIP_MISE" -eq 0 ]]; then
  ensure_local_bin_on_path
  if ! command -v mise >/dev/null 2>&1; then
    install_mise
  else
    echo "mise found: $(command -v mise) ($(mise --version 2>/dev/null || true))"
  fi

  step "Installing mise tools (mise.toml)"
  run mise trust "$ROOT/mise.toml" || true
  run mise install
  activate_mise
else
  step "Skipping mise (--skip-mise)"
  ensure_local_bin_on_path
  activate_mise
fi

require_cmd ruby
require_cmd bundle
if [[ "$SKIP_JS" -eq 0 ]]; then
  require_cmd node
  require_cmd yarn
fi

echo "ruby:  $(ruby -v)"
echo "bundle: $(bundle -v)"
if [[ "$SKIP_JS" -eq 0 ]]; then
  echo "node:  $(node -v)"
  echo "yarn:  $(yarn -v)"
fi

# --- cache directories ---------------------------------------------------------
step "Ensuring shared cache directories"
mkdir -p .cache/bundle .cache/rubygems .cache/yarn .cache/yarn-cache
touch .cache/bundle/.gitkeep .cache/rubygems/.gitkeep .cache/yarn/.gitkeep .cache/yarn-cache/.gitkeep

# --- root gems (rails generators, rubocop) ------------------------------------
step "Installing root gems → .cache/bundle"
if bundle check >/dev/null 2>&1; then
  echo "Root bundle already satisfied"
else
  run bundle install
fi
if [[ "$SKIP_CACHE" -eq 0 ]]; then
  step "Packaging root gems into .cache/rubygems (download cache)"
  cache_gems
fi

# --- app gems + databases -----------------------------------------------------
setup_app() {
  local app="$1"
  step "Setting up ${app}"
  (
    cd "$ROOT/$app"
    if bundle check >/dev/null 2>&1; then
      echo "${app} bundle already satisfied"
    else
      run bundle install
    fi

    if [[ "$SKIP_CACHE" -eq 0 ]]; then
      echo "Packaging ${app} gems into .cache/rubygems (download cache)"
      cache_gems
    fi

    if [[ "$SKIP_DB" -eq 0 ]]; then
      if [[ "$RESET_DB" -eq 1 ]]; then
        run bin/rails db:prepare
        run bin/rails db:reset
      else
        run bin/rails db:prepare
      fi
      run bin/rails log:clear tmp:clear
    else
      echo "Skipping database for ${app} (--skip-db)"
    fi
  )
}

if [[ "$SKIP_APPS" -eq 0 ]]; then
  setup_app fred
  setup_app george
else
  step "Skipping app setup (--skip-apps)"
fi

# --- JavaScript (classic Yarn 1.x workspaces) ---------------------------------
if [[ "$SKIP_JS" -eq 0 ]]; then
  yarn_major="$(yarn --version | cut -d. -f1 || echo 0)"
  if [[ "$yarn_major" -ne 1 ]]; then
    echo "error: this branch expects classic Yarn 1.x (got $(yarn --version))" >&2
    echo "       check mise.toml (yarn = \"1.22.22\") and re-run mise install" >&2
    exit 1
  fi

  step "Installing Yarn 1 workspaces (offline-mirror → .cache/yarn)"
  # Online install fills yarn-offline-mirror (.cache/yarn) and links node_modules.
  run yarn install --frozen-lockfile 2>/dev/null || run yarn install

  if [[ "$SKIP_CACHE" -eq 0 ]]; then
    step "Verifying classic Yarn offline mirror (--offline)"
    # --prefer-offline uses mirror/cache first; --offline requires a full mirror.
    if yarn install --frozen-lockfile --offline; then
      echo "Yarn offline mirror is complete (no network fetch required)"
    else
      echo "warning: yarn --offline failed; re-running online install to fill mirror"
      run yarn install
      if yarn install --frozen-lockfile --offline; then
        echo "Yarn offline mirror is complete after refill"
      else
        echo "warning: yarn offline mirror still incomplete"
        echo "         Docker will use --prefer-offline then fall back to network"
      fi
    fi
  fi
else
  step "Skipping Yarn install (--skip-js)"
fi

# --- cache summary ------------------------------------------------------------
step "Cache summary"
gem_count=0
yarn_count=0
if [[ -d .cache/rubygems ]]; then
  gem_count="$(find .cache/rubygems -type f \( -name '*.gem' -o -name '*.gemspec' \) 2>/dev/null | wc -l | tr -d ' ')"
fi
if [[ -d .cache/yarn ]]; then
  yarn_count="$(find .cache/yarn -type f ! -name '.gitkeep' 2>/dev/null | wc -l | tr -d ' ')"
fi
echo "  .cache/rubygems   : ${gem_count} packaged gem artifacts"
echo "  .cache/bundle     : install tree for host (and container reinstalls)"
echo "  .cache/yarn       : ${yarn_count} classic offline-mirror tarballs"
echo "  .cache/yarn-cache : classic yarn --cache-folder"
echo "  node_modules      : $( [[ -d node_modules ]] && echo present || echo missing )"
echo "  yarn              : $(yarn --version) (classic 1.x expected)"

# --- optional Docker image ----------------------------------------------------
if [[ "$DOCKER_BUILD" -eq 1 ]]; then
  step "Building Docker image"
  require_cmd docker
  if docker compose version >/dev/null 2>&1; then
    run docker compose build
  else
    run docker-compose build
  fi
fi

# --- summary ------------------------------------------------------------------
step "Setup complete"
cat <<EOF
Host tools and download caches are ready for Docker to use preferentially.

  Gem installs:   ${ROOT}/.cache/bundle
  Gem downloads:  ${ROOT}/.cache/rubygems   (bundle install --local)
  Yarn mirror:    ${ROOT}/.cache/yarn       (classic yarn-offline-mirror)
  Yarn cache:     ${ROOT}/.cache/yarn-cache (classic --cache-folder)
  node_modules:   ${ROOT}/node_modules      (bind-mounted into containers)

Recommended Docker flow:
  bin/setup
  docker compose up fred george
  # containers run bin/docker-app → prefer local caches, network only on miss

Next steps:
  yarn test
  (cd fred && bin/rails server -p 3000)
  (cd george && bin/rails server -p 3001)
  docker compose up fred george

Re-run anytime; the script is idempotent.
EOF
