#!/usr/bin/env bash
# docker compose wrapper: loads config/cache-layout.env for ${CACHE_*} interpolation.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LAYOUT="${ROOT}/config/cache-layout.env"

if [[ ! -f "${LAYOUT}" ]]; then
  echo "error: missing ${LAYOUT}" >&2
  exit 1
fi

exec docker compose --env-file "${LAYOUT}" "$@"
