# Single source of truth for monorepo cache *relative* paths (from repo root).
# Host: bin/cache-env prefixes with the monorepo absolute path.
# Docker: compose interpolates as /workspace/${VAR} (via bin/compose --env-file).
#
# Do not put host- or container-absolute paths here.

CACHE_BUNDLE=.cache/bundle
CACHE_RUBYGEMS=.cache/rubygems
CACHE_YARN_MIRROR=.cache/yarn
CACHE_YARN_FOLDER=.cache/yarn-cache
