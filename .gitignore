# Bundler / gem cache (populated locally and in containers)
.cache/bundle/**
!.cache/bundle/.gitkeep
.cache/yarn/**
!.cache/yarn/.gitkeep
.cache/mise/
# Accidental per-app caches (must use monorepo .cache/bundle only)
fred/.cache/
george/.cache/
vendor/bundle/

# App runtime / build artifacts
**/log/*
!**/log/.keep
**/tmp/*
!**/tmp/.keep
!**/tmp/pids/
!**/tmp/pids/.keep
**/storage/*
!**/storage/.keep
**/public/assets
**/public/packs
**/node_modules
**/app/assets/builds/*
!**/app/assets/builds/.keep

# Credentials / secrets (keep example keys)
**/config/master.key
**/config/credentials/*.key
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
*.swp
*~
.idea/
.vscode/
*.code-workspace

# Coverage / test
coverage/
.rspec_status
spec/examples.txt

# Docker
.docker/

# Ruby
*.gem
.ruby-gemset
