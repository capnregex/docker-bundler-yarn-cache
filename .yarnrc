# Classic Yarn 1.x configuration
# Offline mirror: packed tarballs shared by host bin/setup and Docker mounts.
# Prefer this over the global yarn cache so containers see the same downloads.
yarn-offline-mirror "./.cache/yarn"
yarn-offline-mirror-pruning true

# Also pin the user-level yarn cache under the monorepo for host tooling.
# (Docker sets YARN_CACHE_FOLDER to the same tree.)
--cache-folder ".cache/yarn-cache"

# Workspaces: install all packages at the monorepo root.
--install.ignore-engines true
